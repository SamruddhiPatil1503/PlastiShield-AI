<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Material Details"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#176B45"
            android:gravity="center"
            android:padding="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Provide material information for a better AI assessment."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Plastic Type"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerPlasticType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF"
            android:entries="@array/plastic_types"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Material Purity"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerPurity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF"
            android:entries="@array/material_purity"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Contamination"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerContamination"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#FFFFFF"
            android:entries="@array/contamination_types"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Unknown if you cannot identify the material or its condition."
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="18dp"/>

        <Button
            android:id="@+id/btnContinueAnalysis"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Continue to AI Analysis"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#176B45"
            android:layout_marginTop="28dp"/>

    </LinearLayout>
</ScrollView>
